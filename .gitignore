# Dépendances et sorties de build
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# Secrets : jamais versionnés (copiez .env.example en .env)
.env
.env.local
.env.*.local
!.env.example

# Base SQLite de développement et médias envoyés en local
prisma/dev.db*
public/uploads/

# Vercel / éditeurs / OS
.vercel/
.DS_Store
Thumbs.db
.idea/
.vscode/

# Dossier de téléchargement personnel (fichiers reçus de l'assistant IA) —
# ne doit jamais être versionné ni construit : un .ts qui traîne ici sans
# ses imports (ex. "./base") fait planter le build Next.js/TypeScript, ça
# s'est déjà produit deux fois. Si ce dossier existe encore localement,
# supprimez-le du projet (voir conversation) — cette ligne empêche juste
# qu'il revienne un jour par erreur.
Claude outputs/
