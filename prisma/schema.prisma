// Nebula — schéma de données
//
// Base : PostgreSQL (Neon en production). Le schéma évolue par MIGRATIONS
// (dossier prisma/migrations) : après une modification de ce fichier, lancez
// « npx prisma migrate dev --name description_courte » sur une base de dev,
// committez le dossier créé ; le déploiement l'applique tout seul
// (scripts/db-migrate.mjs). Ne plus utiliser « prisma db push » en production.
// Les statuts restent des champs String contraints par les types TypeScript /
// Zod côté application (voir src/lib/types.ts), plutôt que des enums natifs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  // Nullable : un compte créé via la connexion rapide Google/Apple (voir
  // src/lib/auth.ts) n'a pas de mot de passe Nebula — authorize() dans
  // auth.ts vérifie sa présence avant toute comparaison bcrypt.
  passwordHash String?
  name         String
  avatarUrl    String?
  createdAt    DateTime      @default(now())
  memberships  Membership[]
  posts        Post[]
  forumThreads ForumThread[]
  forumReplies ForumReply[]
  sharedVideos SharedVideo[]
  communityReactions CommunityReaction[]
  pollVotes    PollVote[]
  easterEggsFound EasterEggFound[]
  notifications Notification[]
  integrationAccounts IntegrationAccount[]
  apiKeys ApiKey[]
  webhookEndpoints WebhookEndpoint[]
  pendingAdAuths PendingAdAuth[]
  achievementUnlocks AchievementUnlock[]
  challengeCompletions ChallengeCompletion[]
  weeklyMissions     WeeklyMissions[]
  reussiteItems      ReussiteItem[]
  featuredVideos     FeaturedVideo[]
  studioGenerations  StudioGeneration[]
  // L'abonnement appartient au COMPTE (à l'utilisateur), pas à une marque en
  // particulier : il gouverne combien de marques au total ce compte peut
  // créer. Voir src/lib/plans.ts.
  subscription Subscription?

  // --- Parrainage ---
  // Code unique généré à l'inscription, à partager. referredByCode retient
  // le code utilisé par CE compte à son inscription (traçabilité), et
  // aiTrialUntil accorde l'accès IA gratuitement jusqu'à cette date, même
  // sur le palier Gratuit (voir src/lib/billing/plan.ts).
  // Nullable (plutôt que requis) pour que `prisma db push` ne casse jamais
  // sur des comptes déjà existants en base au moment où ce champ est ajouté :
  // les nouveaux comptes en reçoivent toujours un à l'inscription, et les
  // anciens comptes se le voient générer à la première visite de la page
  // Paramètres (voir /api/referral). Une valeur NULL n'entre pas en
  // conflit avec la contrainte @unique (Postgres autorise plusieurs NULL).
  referralCode   String?   @unique
  referredByCode String?
  aiTrialUntil   DateTime?

  // Thème de couleurs choisi dans Paramètres (voir src/lib/themes.ts).
  // "nebula" = thème par défaut d'origine.
  themePreference String @default("nebula")

  // Fond d'écran choisi dans Paramètres (voir src/lib/backgrounds.ts).
  backgroundPreference String @default("mesh")

  // Easter egg : vrai thème étoilé animé (étoiles qui défilent en continu
  // derrière toute l'interface), réservé aux paliers Pro et Agence — voir
  // src/components/starfield.tsx + /api/settings/starfield. Le droit d'accès
  // réel est toujours revérifié côté serveur sur le palier actuel (pas
  // seulement cette préférence enregistrée), donc rétrograder de palier la
  // masque automatiquement sans qu'on ait besoin de la remettre à false ici.
  starfieldEnabled Boolean @default(false)

  // Cosmétiques (voir src/lib/cosmetics.ts) : contenus visuels/sonores RÉELS
  // (pas de simples badges) débloqués par palier — curseurs, halos, sons,
  // décors de page... Chaque clé DOIT exister dans le catalogue COSMETICS
  // pour être prise en compte (voir /api/settings/cosmetics, qui revérifie
  // toujours le palier requis à l'activation, jamais confiance au client).
  // Array plutôt qu'une colonne par cosmétique : le catalogue grandira sans
  // migration supplémentaire à chaque ajout.
  enabledCosmetics String[] @default([])

  // Son "Décollage" (easter egg "publish-sound-unlock", voir
  // easter-eggs-registry.ts) : préférence ON/OFF distincte du déblocage
  // lui-même (found dans EasterEggFound) — trouver l'egg rend le réglage
  // disponible dans Paramètres, cette valeur retient si la personne l'a
  // effectivement activé.
  publishSoundEnabled Boolean @default(false)

  // --- Suivi de connexion (voir /api/easter-eggs, calculé à chaque visite
  // de /succes ou de la Communauté : un compte qui ne visite ni l'une ni
  // l'autre un jour donné ne fait pas progresser ces compteurs ce jour-là) ---

  // Easter egg "Icône rétro" (clé "retro-icon-unlock") : jours CONSÉCUTIFS
  // avec au moins une visite, remis à 1 dès qu'un jour est manqué.
  lastLoginDate   DateTime?
  loginStreakDays Int       @default(0)

  // Easter egg "Message d'accueil personnalisé" (clé "greeting-unlock") :
  // connexions à peu près à la même heure (± 1h, l'heure du serveur n'étant
  // stockée qu'en entier) sur des jours consécutifs.
  lastLoginHour       Int?
  sameHourLoginStreak Int @default(0)

  // Mode clair/sombre choisi via la bulle de profil (voir mode-provider.tsx).
  // "dark" = défaut d'origine (Nébuleuse bleu foncé). Indépendant du thème
  // de couleurs (themePreference) : le mode inverse simplement les surfaces
  // (fond/texte/panneaux) par-dessus n'importe quel thème choisi.
  colorMode String @default("dark")

  // Mode focus (Lot 3 de la refonte) : vrai par défaut pour tout le monde.
  // Quand il est actif, l'application ne montre ni easter eggs ambiants
  // (messages « Toujours là ? », étoiles filantes de minuit...) ni toasts
  // « succès débloqué » : les découvertes sont toujours enregistrées (page
  // Succès), mais rien ne vient interrompre le travail. Désactivable dans
  // Paramètres → Apparence & Succès.
  focusMode Boolean @default(true)

  // Notification par email quand une publication PROGRAMMÉE échoue (Lot 4) :
  // envoyée par le worker planifié à l'auteur de la publication (voir
  // runDuePosts dans src/lib/publish.ts). Une publication envoyée
  // « maintenant » affiche son résultat à l'écran, pas d'email pour elle.
  notifyOnFailure Boolean @default(true)

  // --- Marque blanche (palier Agence uniquement, voir src/lib/plans.ts) ---
  // Remplace "Nebula" par votre propre nom/logo dans la barre de navigation
  // (voir topnav.tsx) — utile pour une agence qui montre l'outil à ses
  // clients. Champs nullables : tant qu'ils sont vides, "Nebula" reste
  // affiché normalement, même pour un compte Agence.
  whiteLabelBrandName String?
  whiteLabelLogoUrl   String?

  // --- Réinitialisation de mot de passe ---
  // On ne stocke jamais le jeton en clair : passwordResetTokenHash est le
  // hash SHA-256 du jeton envoyé par email (voir src/lib/password-reset.ts).
  // Nullable pour les mêmes raisons que referralCode ci-dessus.
  passwordResetTokenHash      String?   @unique
  passwordResetTokenExpiresAt DateTime?

  // Vérification de l'adresse e-mail (audit sécurité, lot 1). Avant, un
  // inconnu pouvait créer un compte avec l'adresse de quelqu'un d'autre
  // (sans jamais prouver qu'il la possède), et ce compte était ensuite
  // ouvert à la vraie personne lors de son « Continuer avec Google », mot de
  // passe de l'inconnu compris.
  // - emailVerifiedAt : date de confirmation. Valeur par défaut « maintenant »
  //   pour que les comptes existants (créés avant cette vérification) ne
  //   soient pas bloqués ; l'inscription par mot de passe la met à null
  //   jusqu'au clic sur le lien reçu par e-mail. Google/Apple : confirmée
  //   d'office quand le fournisseur garantit l'adresse (email_verified).
  // - emailVerifyTokenHash : hash SHA-256 du jeton envoyé par e-mail (jamais
  //   le jeton en clair, comme pour la réinitialisation du mot de passe).
  emailVerifiedAt           DateTime? @default(now())
  emailVerifyTokenHash      String?   @unique
  emailVerifyTokenExpiresAt DateTime?
  // Compteur de sessions : l'augmenter déconnecte immédiatement toutes les
  // sessions ouvertes de ce compte (voir le rappel jwt de src/lib/auth.ts).
  // Augmenté à la réinitialisation du mot de passe et quand un compte non
  // confirmé est repris par le vrai propriétaire de l'adresse.
  sessionVersion            Int       @default(0)
  // Identifiant Facebook du compte qui s'est connecté via « Continuer avec
  // Meta » : Facebook ne garantit pas que l'adresse e-mail transmise a été
  // vérifiée, on ne relie donc un compte existant QUE par cet identifiant.
  facebookLoginId           String?   @unique

  // --- Croissance (brief growth du 23/09/2026) ---
  // Attribution « premier contact » : copiée depuis le cookie nb_attr posé
  // par src/middleware.ts au moment de l'inscription (formulaire ou
  // connexion rapide). Lue par la page propriétaire /admin/acquisition.
  acqSource   String?
  acqMedium   String?
  acqCampaign String?
  acqContent  String?
  // Slug de la marque dont le badge « Propulsé par Nebula » (ou le bloc de
  // conversion) a amené la visite — récompensée d'un mois de Pro quand ce
  // compte devient payant (voir src/lib/billing/rewards.ts).
  acqVia      String?
  acqLanding  String?
  acqAt       DateTime?
  // Première souscription payante (webhook Stripe) — jamais réécrite.
  firstPaidAt DateTime?
  // Essai Pro applicatif (« reverse trial ») : Pro tant que cette date est
  // dans le futur et qu'aucun abonnement payant n'est actif. Posé à
  // l'inscription (14 j, 30 j avec un code de parrainage) ; les comptes
  // gratuits existants au déploiement le reçoivent une fois via le cron.
  // Un seul essai par email, jamais réinitialisé. Voir getUserPlan().
  trialEndsAt DateTime?
  // Fin d'essai déjà appliquée (liens au-delà de la limite désactivés,
  // rapports/calendrier dépubliés) et modale « essai terminé » déjà vue.
  trialExpiredAppliedAt DateTime?
  trialEndedNoticeAt    DateTime?
  // Offre unique de bienvenue (-50 % premier mois, 48 h) : posée à la
  // première ouverture d'une modale de mise à niveau hors essai.
  offerExpiresAt DateTime?
  offerUsedAt    DateTime?
  // Mois de Pro gagnés (badge apporteur, parrainage) en attente d'être
  // consommés à la prochaine souscription — pour un compte sans abonnement
  // Stripe actif (sinon le coupon est appliqué directement à l'abonnement).
  bonusMonths Int @default(0)
  // Abonnement Stripe sur lequel un mois offert a déjà été consommé via le
  // coupon du Checkout (25/09/2026) : évite de le décompter deux fois quand
  // Stripe envoie plusieurs événements pour le même abonnement, ou de ne
  // jamais le décompter lors d'un réabonnement (voir /api/billing/webhook).
  bonusConsumedSubId String?
  // Nombre de factures mensuelles payées (rappel annuel à la 3e).
  paidInvoices Int @default(0)
  // Emails de conseils (cycle de vie) — désinscription dans Paramètres ou
  // via le lien de chaque email. Les emails de service (essai) restent.
  lifecycleEmails Boolean @default(true)
  // Déclencheurs d'invitation au parrainage déjà affichés (clés).
  referralPromptsSeen Json?

  // --- Réussites (niveaux de créateur) ---
  // Copie à jour du total d'XP et du rang (voir src/lib/reussites/engine.ts ;
  // creatorLevel = palier de rang 1 à 15 depuis Réussites v2, 1 à 8 avant),
  // recalculée à chaque évaluation : sert au menu, au tableau de bord et au
  // badge de niveau dans la Communauté sans refaire les sommes à chaque fois.
  creatorXp          Int       @default(0)
  creatorLevel       Int       @default(1)
  // Dernière évaluation complète (limite la fréquence des recalculs) et
  // dernière visite de la page Réussites (compteur du menu).
  reussitesCheckedAt DateTime?
  reussitesSeenAt    DateTime?
  // Vitrine (Réussites v2, lot B) : jusqu'à 3 badges gagnés choisis par le
  // créateur (clés d'accomplissement ou d'étoile), montrés à côté de son nom
  // dans la Communauté et sur sa carte de créateur.
  showcase           String[]  @default([])
  // Lot C : accord pour que ses vidéos partagées dans la Communauté puissent
  // être mises « à la une » (retirable à tout moment), et nombre d'outils
  // gratuits essayés avant l'inscription (badge Explorateur).
  featureConsent     Boolean   @default(false)
  toolsExplored      Int       @default(0)
  lifecycleEmailsSent LifecycleEmail[]
  growthEvents        GrowthEvent[]
  // Accès offert (partenaires, streamers, testeurs — décision du
  // 24/09/2026) : palier attribué sans abonnement Stripe, jusqu'à compUntil
  // (null = sans limite). Lu par getUserPlan() juste après l'abonnement
  // payant. Posé via /admin/partenaires (PartnerGrant).
  compPlan      String?
  compMaxBrands Int?
  compUntil     DateTime?
  compNote      String?
  partnerGrants PartnerGrant[]
}

// Accès offerts par le propriétaire (voir /admin/partenaires et
// src/lib/billing/partners.ts) : une ligne par attribution, par email — le
// compte n'a pas besoin d'exister encore : l'accès s'applique à
// l'inscription (register + connexions Google/Meta/Apple) via
// applyPendingPartnerGrant(). `revokedAt` conserve l'historique.
model PartnerGrant {
  id        String    @id @default(cuid())
  email     String
  plan      String // PRO | AGENCY
  maxBrands Int
  months    Int? // null = sans limite
  note      String?
  createdAt DateTime  @default(now())
  appliedAt DateTime?
  expiresAt DateTime?
  revokedAt DateTime?
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])

  // Index (lot 3, qualité) : clés étrangères et filtres fréquents — Postgres
  // n'indexe pas les clés étrangères tout seul.
  @@index([userId])
}

// Onglet "Succès" (voir /succes) : chaque ligne = un easter egg trouvé par un
// compte, une seule fois (@@unique). `key` correspond à EASTER_EGGS dans
// src/lib/easter-eggs-registry.ts, jamais renommée ensuite car stockée ici.
// Écrite via markEasterEggFound() (serveur) ou POST /api/easter-eggs/found
// (client), jamais en accès direct depuis le front.
model EasterEggFound {
  id      String   @id @default(cuid())
  userId  String
  key     String
  foundAt DateTime @default(now())
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
}

// Ligne UNIQUE (id fixe "singleton", géré par upsert dans
// src/lib/referral-crown-streak.ts) : suit combien de jours CONSÉCUTIFS le
// titulaire actuel de la 1ère place du classement de parrainage
// (/api/referral/leaderboard) l'a occupée — vérifié une fois par jour
// civil (UTC) à chaque exécution de /api/cron ou du worker (scripts/worker.ts).
// Alimente l'easter egg à récompense "referral-crown-30d". Pas de relation
// vers User (onDelete non pertinent ici) : un compte supprimé fait juste
// disparaître son propre historique de parrainage, le streak retombe à 0
// tout seul au prochain passage du cron.
model ReferralCrownStreak {
  id       String    @id
  userId   String?
  days     Int       @default(0)
  lastDate DateTime?
}

model Brand {
  id             String             @id @default(cuid())
  name           String
  slug           String             @unique
  logoUrl        String?
  timezone       String             @default("Europe/Paris")
  createdAt      DateTime           @default(now())
  memberships    Membership[]
  connections    SocialConnection[]
  posts          Post[]
  media          MediaAsset[]
  competitors    CompetitorTrack[]
  approvalLinks  ApprovalLink[]
  linkPage       LinkPage?
  report         BrandReport?
  calendarShare  CalendarShare?
  adAccounts     AdAccount[]
  studioGenerations StudioGeneration[]
  mediaKit       MediaKit?
}

// Calendrier client en lecture seule (produit n°7 de la feuille de route) :
// une page publique par marque montrant les prochaines publications déjà
// programmées, sans aucun droit d'édition — complète les rapports du
// produit n°6 (qui regardent en arrière) avec une vue vers l'avant. Une
// seule ligne par marque (relation 1-1), créée à la volée comme LinkPage et
// BrandReport. Réservé aux paliers Pro/Agence (calendarShareEnabled dans
// src/lib/plans.ts).
model CalendarShare {
  id         String   @id @default(cuid())
  brandId    String   @unique
  brand      Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  token      String   @unique @default(cuid())
  enabled    Boolean  @default(false)
  windowDays Int      @default(30)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Rapport client automatique (produit n°6 de la feuille de route) : une page
// publique de reporting par marque (croissance des abonnés, publications de
// la période), recalculée à la volée à chaque visite à partir des données
// déjà collectées (AnalyticsSnapshot, Post/PostTarget) — jamais un instantané
// figé, donc toujours à jour même entre deux envois email. L'envoi email
// périodique (voir runDueReports() dans src/lib/reports.ts, appelé par
// /api/cron) n'est qu'un rappel vers ce même lien public, jamais une pièce
// jointe ni un contenu généré une fois pour toutes. Réservé aux paliers
// Pro/Agence (reportsEnabled dans src/lib/plans.ts). Une seule ligne par
// marque (relation 1-1), créée à la volée comme LinkPage.
model BrandReport {
  id             String    @id @default(cuid())
  brandId        String    @unique
  brand          Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  token          String    @unique @default(cuid())
  enabled        Boolean   @default(false)
  periodDays     Int       @default(30)
  recipientEmail String?
  frequency      String    @default("OFF") // "OFF" | "WEEKLY" | "MONTHLY"
  lastSentAt     DateTime?
  nextSendAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// Page "link in bio" publique de la marque (façon Linktree), accessible sans
// connexion à /l/[slug] via le slug (déjà unique) de la marque. Une seule
// page par marque : relation 1-1 avec Brand. "published" contrôle la
// visibilité publique indépendamment de l'existence de la ligne (permet de
// préparer la page puis de la publier plus tard). "theme" réutilise les clés
// de src/lib/themes.ts (mêmes 14 palettes que le reste de l'appli, avec la
// même vérification de palier via requiresPlan) pour que la page publique
// s'accorde avec l'identité visuelle choisie par la marque.
model LinkPage {
  id        String     @id @default(cuid())
  brandId   String     @unique
  brand     Brand      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  title     String     @default("")
  bio       String     @default("")
  avatarUrl String?
  theme     String     @default("nebula")
  // Cadre animé autour de la carte (voir src/lib/bio-frames.ts) : null =
  // automatique (halo sur Or Impérial / Éclipse totale), "none" = aucun.
  frame     String?
  published Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  links     LinkItem[]
}

// Un bouton/lien affiché sur la page publique. "clicks" est incrémenté par
// /api/public/link-in-bio/[slug]/click à chaque clic visiteur, pour donner à
// la marque un minimum de statistiques sans avoir besoin d'analytics tiers.
model LinkItem {
  id         String   @id @default(cuid())
  linkPageId String
  linkPage   LinkPage @relation(fields: [linkPageId], references: [id], onDelete: Cascade)
  label      String
  url        String
  order      Int      @default(0)
  enabled    Boolean  @default(true)
  clicks     Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([linkPageId])
}

// plan     : "FREE" | "PRO" | "AGENCY" (voir src/lib/plans.ts)
// status   : "ACTIVE" | "TRIALING" | "PAST_DUE" | "CANCELED" | "INCOMPLETE"
// maxBrands: palier "nombre de marques" choisi (3/5/10 en Pro, 15/25/50 en
//            Agence) — voir src/lib/plans.ts pour la grille de prix associée.
model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  plan                 String    @default("FREE")
  // "month" | "year" — intervalle de facturation choisi par le client.
  interval             String    @default("month")
  maxBrands            Int       @default(1)
  status               String    @default("ACTIVE")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  // Pause plutôt qu'annulation (Stripe pause_collection, behavior "void") :
  // tant que cette date est dans le futur, le compte est traité en Gratuit,
  // les données sont conservées, et Stripe reprend seul à cette date.
  pausedUntil          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Rôle : "OWNER" | "EDITOR" | "VIEWER"
model Membership {
  id      String @id @default(cuid())
  role    String @default("EDITOR")
  userId  String
  brandId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([userId, brandId])

  // Index (lot 3, qualité) : clés étrangères et filtres fréquents — Postgres
  // n'indexe pas les clés étrangères tout seul.
  @@index([brandId, role])
}

// network : "INSTAGRAM" | "FACEBOOK" | "TIKTOK" | "YOUTUBE" | "BLUESKY" (+ plus tard "X" | "LINKEDIN")
// status  : "CONNECTED" | "EXPIRED" | "ERROR" | "DISCONNECTED"
model SocialConnection {
  id                String              @id @default(cuid())
  brandId           String
  network           String
  externalAccountId String
  displayName       String
  handle            String?
  avatarUrl         String?
  accessToken       String
  refreshToken      String?
  tokenExpiresAt    DateTime?
  scopes            String              @default("")
  status            String              @default("CONNECTED")
  lastError         String?
  connectedAt       DateTime            @default(now())
  lastSyncedAt      DateTime?
  // Distinct de lastSyncedAt ci-dessus (qui suit la synchro Analytics) : la
  // boîte de réception /interactions se rafraîchit indépendamment, sur sa
  // propre action "Actualiser" — voir /api/engagement/sync.
  lastEngagementSyncedAt DateTime?
  // Idem pour la page Engagements (métriques par publication : likes,
  // partages…) — voir /api/engagements/sync.
  lastMetricsSyncedAt DateTime?
  // Identifiant de la PERSONNE qui a donné l'autorisation chez le réseau
  // (lot 2, fiabilité) : compte Facebook pour Instagram/Facebook, compte
  // Threads pour Threads. Sert aux rappels de Meta « application retirée » /
  // « suppression des données » (voir /api/meta/*), qui ne donnent que cet
  // identifiant. Vide pour les connexions faites avant cette mise à jour.
  authUserId        String?
  brand             Brand               @relation(fields: [brandId], references: [id], onDelete: Cascade)
  targets           PostTarget[]
  analytics         AnalyticsSnapshot[]
  videoInsights     VideoInsight[]
  engagementItems   EngagementItem[]
  postMetrics       PostMetric[]

  @@unique([brandId, network, externalAccountId])
  @@index([authUserId])
}

// Métriques d'ENGAGEMENT par publication (page /engagements) : likes,
// commentaires, partages, enregistrements, vues — remontées depuis l'API
// officielle de chaque réseau (SocialClient.fetchPostMetrics, optionnel :
// tous les réseaux n'exposent pas tout, un champ absent reste null et
// s'affiche « — »). Une ligne par publication et par compte, mise à jour à
// chaque « Actualiser » : les colonnes prev* gardent les valeurs de
// l'actualisation précédente pour afficher « +12 depuis la dernière fois »
// sans historique complet à stocker. Distinct de EngagementItem (le TEXTE
// des commentaires, page /comments) et d'AnalyticsSnapshot (chiffres du
// COMPTE : abonnés, portée).
model PostMetric {
  id             String           @id @default(cuid())
  connectionId   String
  network        String
  postExternalId String
  title          String?
  permalink      String?
  thumbnailUrl   String?
  publishedAt    DateTime?
  views          Int?
  likes          Int?
  comments       Int?
  shares         Int?
  saves          Int?
  prevViews      Int?
  prevLikes      Int?
  prevComments   Int?
  prevShares     Int?
  prevSaves      Int?
  capturedAt     DateTime         @default(now())
  prevCapturedAt DateTime?
  connection     SocialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, postExternalId])
  @@index([connectionId, publishedAt])
}

// type : "VIDEO" | "IMAGE"
model MediaAsset {
  id              String      @id @default(cuid())
  brandId         String
  type            String
  url             String
  filename        String
  mimeType        String
  sizeBytes       Int
  durationSeconds Float?
  width           Int?
  height          Int?
  thumbnailUrl    String?
  // Source d'un média importé (Réussites v2) : « gdrive », « dropbox »,
  // « onedrive », « unsplash », « canva » ou « api » ; null = envoyé depuis
  // l'appareil. Sert aux missions « publier un média importé ».
  importSource    String?
  createdAt       DateTime    @default(now())
  brand           Brand       @relation(fields: [brandId], references: [id], onDelete: Cascade)
  postMedia       PostMedia[]

  // Index (lot 3, qualité) : clés étrangères et filtres fréquents — Postgres
  // n'indexe pas les clés étrangères tout seul.
  @@index([brandId, createdAt])
}

// status : "DRAFT" | "SCHEDULED" | "PUBLISHING" | "PUBLISHED" | "FAILED" | "PARTIAL"
model Post {
  id           String        @id @default(cuid())
  brandId      String
  createdById  String
  title        String        @default("") // utilisé notamment comme titre YouTube
  caption      String        @default("") // description/légende par défaut
  // Commentaire publié automatiquement juste après la publication (bulle
  // "Premier commentaire" du Composer/Importation). Optionnel — laissé vide
  // si l'utilisateur ne souhaite pas en ajouter. Voir src/lib/publish.ts et
  // SocialClient.postComment (src/lib/social/base.ts) : best-effort, ne fait
  // jamais échouer la publication elle-même si l'ajout du commentaire échoue.
  firstComment String?
  status       String        @default("DRAFT")
  scheduledAt  DateTime?
  duplicatedFromId String?
  // Import CSV (brief growth, lot G6.a) : URL distante du média conservée
  // en référence tant qu'il n'a pas été rapatrié vers notre stockage par la
  // tâche de fond (src/lib/import-media.ts) ; le compteur d'essais évite de
  // réessayer indéfiniment une URL morte (abandon après 3 essais, la fiche
  // invite alors à ajouter le média à la main).
  sourceMediaUrl      String?
  sourceMediaAttempts Int       @default(0)
  importedAt          DateTime?
  // Début de la publication en cours (lot 2, fiabilité) : posé au moment
  // où un passage du cron (ou « Publier maintenant ») PREND la publication,
  // de façon atomique — deux passages simultanés ne peuvent plus publier le
  // même post deux fois. Sert aussi à repérer une publication interrompue.
  publishingStartedAt DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  brand        Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdBy    User          @relation(fields: [createdById], references: [id])
  media        PostMedia[]
  targets      PostTarget[]
  messages     PostMessage[]
  approval     PostApproval?

  @@index([status, scheduledAt])

  // Index (lot 3, qualité) : clés étrangères et filtres fréquents — Postgres
  // n'indexe pas les clés étrangères tout seul.
  @@index([brandId, scheduledAt])
  @@index([brandId, createdAt])
  @@index([createdById, status])
}

model PostMedia {
  id           String     @id @default(cuid())
  postId       String
  mediaAssetId String
  order        Int        @default(0)
  post         Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  // Index (lot 3, qualité) : clés étrangères et filtres fréquents — Postgres
  // n'indexe pas les clés étrangères tout seul.
  @@index([postId])
  @@index([mediaAssetId])
}

// network : voir SocialConnection.network
// status  : "PENDING" | "SCHEDULED" | "PUBLISHING" | "PUBLISHED" | "FAILED"
model PostTarget {
  id               String            @id @default(cuid())
  postId           String
  connectionId     String
  network          String
  titleOverride    String?
  captionOverride  String?
  // Réglages propres à CE réseau pour cette publication (ex. YouTube :
  // confidentialité, "fait pour les enfants", catégorie, tags, playlist,
  // notifier les abonnés — voir composer-types.ts → YoutubeOptions). JSON
  // libre pour pouvoir ajouter d'autres réseaux plus tard sans migration.
  // Toujours optionnel : absent, le réseau applique ses valeurs par défaut
  // (voir src/lib/social/*.ts).
  metadata         Json?
  status           String            @default("PENDING")
  externalPostId   String?
  externalUrl      String?
  errorMessage     String?
  attempts         Int               @default(0)
  publishedAt      DateTime?
  // Publication « en traitement » chez le réseau (lot 2, fiabilité) :
  // Instagram, TikTok, Threads, LinkedIn et Pinterest traitent les vidéos
  // de leur côté pendant de longues minutes. Au lieu d'attendre dans la
  // requête (coupée par Vercel) ou de déclarer un succès à l'aveugle, la
  // cible passe à PROCESSING avec son point de reprise (checkpoint : id du
  // conteneur, du publish_id…) et le cron la termine plus tard.
  checkpoint       Json?
  nextCheckAt      DateTime?
  processingSince  DateTime?
  // Appel en cours vers le réseau depuis… (repère les publications
  // interrompues par un arrêt de la fonction).
  startedAt        DateTime?
  // Résilience des API (lot 5) : catégorie de la dernière erreur (voir
  // src/lib/social/errors.ts — AUTH_EXPIRED, RATE_LIMITED, TRANSIENT…, ou
  // PAUSED quand le réseau est suspendu) et nombre de relances automatiques
  // déjà faites. Statut RETRY_WAIT : nouvel essai prévu à nextCheckAt.
  errorCategory    String?
  autoRetries      Int               @default(0)
  // Début du dernier envoi vers le réseau (lot 6) : fenêtre de recherche
  // de la vérification « déjà en ligne ? » (voir social/reconcile.ts).
  lastAttemptAt    DateTime?
  // Miniature choisie dans Publier, envoyée au réseau (YouTube, lot B des
  // Réussites) : « APPLIED », « REFUSED » (chaîne non vérifiée…),
  // « UNSUPPORTED » (format ou poids refusé) ou « FAILED ». null = aucune.
  thumbnailStatus  String?
  post             Post              @relation(fields: [postId], references: [id], onDelete: Cascade)
  connection       SocialConnection  @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  insights         VideoInsight[]

  @@index([status, nextCheckAt])

  // Index (lot 3, qualité) : clés étrangères et filtres fréquents — Postgres
  // n'indexe pas les clés étrangères tout seul.
  @@index([postId])
  @@index([connectionId, status])
}

// Analyse IA de la performance d'une publication vidéo (rétention YouTube +
// lecture des frames aux points de décrochage). Voir src/lib/ai/*.
// postTargetId reste rempli pour une analyse lancée depuis une publication
// Nebula (voir /posts/[id], flux historique). connectionId + videoId sont
// remplis à la place pour une analyse lancée depuis l'outil autonome
// /retention (voir produit n°3 de la feuille de route "roadmap-produits-
// nebula") : n'importe quelle vidéo de la chaîne YouTube connectée, publiée
// ou non via Nebula. Les deux couples sont optionnels et mutuellement
// indépendants — jamais les deux vides en pratique, mais rien ne l'impose
// au niveau du schéma (validé côté application).
model VideoInsight {
  id              String          @id @default(cuid())
  postTargetId    String?
  postTarget      PostTarget?     @relation(fields: [postTargetId], references: [id], onDelete: Cascade)
  connectionId    String?
  connection      SocialConnection? @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  videoId         String?
  summary         String
  dropOffPoints   String // JSON : [{ timeRatio, watchRatio, note }]
  recommendations String // JSON : string[]
  retentionCurve  String // JSON : [{ timeRatio, watchRatio }]
  createdAt       DateTime        @default(now())

  @@index([postTargetId, createdAt])
  @@index([connectionId, videoId, createdAt])
}

// role : "USER" | "ASSISTANT"
model PostMessage {
  id        String   @id @default(cuid())
  postId    String
  role      String
  authorId  String?
  content   String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

model AnalyticsSnapshot {
  id              String           @id @default(cuid())
  connectionId    String
  network         String
  capturedAt      DateTime         @default(now())
  followers       Int              @default(0)
  followersDelta  Int              @default(0)
  engagementRate  Float            @default(0)
  impressions     Int              @default(0)
  reach           Int              @default(0)
  postsCount      Int              @default(0)
  raw             String?
  connection      SocialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, capturedAt])
}

// Boîte de réception d'engagement PAR COMPTE connecté (façon "Community" de
// Buffer) : commentaires reçus sur les publications de CE compte, remontés
// depuis l'API officielle de chaque réseau (voir src/lib/social/*.ts →
// fetchEngagement, méthode optionnelle — tous les réseaux ne l'exposent pas,
// voir tiktok.ts) et rafraîchis à la demande depuis /interactions, ouverte
// via le menu déroulant d'un compte sur la page Comptes. externalId sert de
// clé de déduplication (@@unique) pour qu'une resynchronisation répétée
// n'insère jamais deux fois le même commentaire.
// type : pour l'instant toujours "COMMENT" (le champ existe déjà pour
// accueillir un futur type "MESSAGE" — DM — si Nebula ajoute cet accès un
// jour, sans nouvelle migration).
model EngagementItem {
  id              String           @id @default(cuid())
  connectionId    String
  network         String
  type            String           @default("COMMENT")
  externalId      String
  postExternalId  String?
  postPermalink   String?
  authorName      String?
  authorAvatarUrl String?
  text            String?
  permalink       String?
  publishedAt     DateTime?
  read            Boolean          @default(false)
  // Réponse du compte lui-même repérée à la synchro (Réussites v2, lot B) :
  // date de la première réponse du compte à ce commentaire, d'où qu'elle
  // ait été écrite (appli du réseau ou autre). null = pas de réponse vue.
  ownerRepliedAt  DateTime?
  createdAt       DateTime         @default(now())
  connection      SocialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalId])
  @@index([connectionId, publishedAt])
}

// ---------------------------------------------------------------------------
// Communauté Nebula — espace public, commun à tous les utilisateurs (pas de
// scoping par marque). Forum de discussion, guides d'utilisation, et partage
// volontaire de vidéos déjà publiées (lien + miniature uniquement, jamais de
// réhébergement du fichier source).
// ---------------------------------------------------------------------------

// category : "GENERAL" | "AIDE" | "SUGGESTIONS" | "SHOWCASE"
model ForumThread {
  id        String       @id @default(cuid())
  authorId  String
  title     String
  body      String
  category  String       @default("GENERAL")
  pinned    Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  author    User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replies   ForumReply[]
  reactions CommunityReaction[]

  @@index([createdAt])

  // Index (lot 3, qualité) : clés étrangères et filtres fréquents — Postgres
  // n'indexe pas les clés étrangères tout seul.
  @@index([authorId])
}

model ForumReply {
  id        String      @id @default(cuid())
  threadId  String
  authorId  String
  body      String
  createdAt DateTime    @default(now())
  thread    ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reactions CommunityReaction[]

  @@index([threadId, createdAt])

  // Index (lot 3, qualité) : clés étrangères et filtres fréquents — Postgres
  // n'indexe pas les clés étrangères tout seul.
  @@index([authorId])
}

// Contenu éditorial fixe (pas d'auteur "utilisateur") — géré via le script de
// seed (prisma/seed.ts). Inclut un guide de démarrage pré-rempli.
model Guide {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  summary   String
  body      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Partage volontaire d'un post déjà publié par son auteur : on ne stocke que
// le lien externe (vers la plateforme d'origine) et une miniature, jamais le
// fichier vidéo lui-même — les données sont recopiées au moment du partage
// pour ne pas dépendre du cycle de vie du post/brand d'origine.
model SharedVideo {
  id           String   @id @default(cuid())
  authorId     String
  postTargetId String? // simple référence informative, pas de relation FK
  network      String
  title        String
  externalUrl  String
  thumbnailUrl String?
  note         String?
  createdAt    DateTime @default(now())
  author       User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  featured     FeaturedVideo[]

  @@index([createdAt])

  // Index (lot 3, qualité) : clés étrangères et filtres fréquents — Postgres
  // n'indexe pas les clés étrangères tout seul.
  @@index([authorId])
}

// Vidéo à la une dans la Communauté (Réussites v2, lot C) : 7 jours, 3 à la
// fois, seulement une vidéo déjà partagée par un créateur qui l'accepte
// (User.featureConsent). Gagnée au rang Constellation ou dans le coffre
// (objet « feature » de ReussiteItem), ou choisie par le propriétaire du
// site. Retirable par le créateur et par le propriétaire (removedAt).
// source : « rank » | « chest » | « admin ».
model FeaturedVideo {
  id            String      @id @default(cuid())
  userId        String
  sharedVideoId String
  source        String
  startsAt      DateTime
  endsAt        DateTime
  removedAt     DateTime?
  removedBy     String?
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sharedVideo   SharedVideo @relation(fields: [sharedVideoId], references: [id], onDelete: Cascade)

  @@index([endsAt])
  @@index([userId])
  @@index([sharedVideoId])
}

// Défi collectif du mois (Réussites v2, lot C) : un objectif commun à tous
// les créateurs (vidéos mises en ligne dans le mois). Objectif automatique
// (mois précédent + 10 %, minimum 10) ou fixé par le propriétaire du site.
// reachedAt : objectif atteint (chaque participant reçoit le badge
// collectif du mois, ChallengeCompletion kind « COLLECTIVE »).
model CollectiveChallenge {
  id        String    @id @default(cuid())
  month     String    @unique
  metric    String    @default("videos")
  target    Int
  source    String    @default("auto")
  reachedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// Rareté réelle des badges (Réussites v2, lot C) : part des créateurs
// (comptes ayant publié au moins une fois) qui ont chaque accomplissement
// ou étoile. Recalculée une fois par jour par le cron ; jamais par
// personne, seulement des totaux.
model BadgeRarity {
  key        String   @id
  owners     Int
  creators   Int
  share      Float
  computedAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Suivi de la concurrence (Analytics → sous-onglet "Concurrence").
// Aucune API publique fiable ne permet de récupérer automatiquement et
// légalement les stats d'un compte tiers arbitraire sur ces réseaux sans
// accès spécial audité par chaque plateforme : on suit donc chaque
// concurrent à partir de relevés que VOUS observez et saisissez vous-même
// (nombre d'abonnés public, visible sur son profil) — une vraie donnée que
// vous avez constatée, jamais une valeur inventée par Nebula. L'historique
// de vos relevés permet de tracer une vraie courbe de progression à
// comparer avec la vôtre (déjà réelle, via AnalyticsSnapshot).
model CompetitorTrack {
  id        String               @id @default(cuid())
  brandId   String
  network   String
  handle    String // ex: "@nomduconcurrent"
  label     String? // nom affiché, optionnel
  createdAt DateTime             @default(now())
  brand     Brand                @relation(fields: [brandId], references: [id], onDelete: Cascade)
  snapshots CompetitorSnapshot[]

  @@index([brandId])
}

model CompetitorSnapshot {
  id          String          @id @default(cuid())
  trackId     String
  followers   Int
  postsCount  Int?
  capturedAt  DateTime        @default(now())
  track       CompetitorTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([trackId, capturedAt])
}

// ---------------------------------------------------------------------------
// Workflow d'approbation client (palier Agence) — un lien externe, sans
// compte Nebula requis, pour que le client d'une agence valide ou commente
// les publications à venir de sa marque. Le token fait office de secret
// d'accès (comme un lien de partage classique) : quiconque le possède peut
// voir et répondre, mais ne peut rien faire d'autre sur le compte.
model ApprovalLink {
  id        String    @id @default(cuid())
  brandId   String
  token     String    @unique
  label     String    @default("Lien client")
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  brand     Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
}

// status : "PENDING" | "APPROVED" | "CHANGES_REQUESTED"
model PostApproval {
  id            String    @id @default(cuid())
  postId        String    @unique
  status        String    @default("PENDING")
  comment       String?
  respondedName String?
  respondedAt   DateTime?
  createdAt     DateTime  @default(now())
  post          Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
}

// Quota anti-abus pour les outils IA gratuits et sans compte (voir /outils,
// produit n°2 de la feuille de route "aimant à visiteurs"). ipHash est un
// hash SHA-256 de l'IP du visiteur (jamais l'IP en clair, voir
// src/lib/public-tools-limit.ts) ; "tool" distingue chaque outil
// (ex: "captions", "thumbnail") car ils n'ont pas le même coût ni la même
// limite quotidienne ; "day" est la date au format AAAA-MM-JJ (UTC), ce qui
// fait naturellement repartir le compteur à zéro chaque jour sans job de
// nettoyage dédié (les vieilles lignes peuvent être purgées périodiquement,
// mais leur accumulation reste négligeable en volume).
model PublicToolUsage {
  id      String   @id @default(cuid())
  ipHash  String
  tool    String
  day     String
  count   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([ipHash, tool, day])
}

// Pack d'emojis/réactions exclusifs Premium ("Or Impérial"), généré via IA
// (voir /api/premium/reactions/generate et lib/ai/gemini.ts::
// generateStickerPack). "key" est l'identifiant stable utilisé côté front
// (ex: "gold-fire", préfixé "premium:" dans CommunityReaction.emoji) : la
// génération relance un upsert sur cette clé plutôt que de dupliquer les
// lignes à chaque régénération du pack.
model PremiumReaction {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  imageUrl  String
  createdAt DateTime @default(now())
}

// Réaction (emoji standard OU clé du pack Premium préfixée "premium:") posée
// par un utilisateur sur un thread ou une réponse de la Communauté (jamais
// les deux à la fois, voir /api/community/reactions). Basculer la même
// réaction une seconde fois la retire (toggle), d'où l'absence de contrainte
// d'unicité ici : la logique de toggle vit dans la route, pas dans le schéma.
model CommunityReaction {
  id        String      @id @default(cuid())
  userId    String
  threadId  String?
  replyId   String?
  emoji     String
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread    ForumThread? @relation(fields: [threadId], references: [id], onDelete: Cascade)
  reply     ForumReply?  @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([replyId])
  @@index([userId])
}

// Sondage éditorial (création réservée à l'admin, voir
// /api/community/polls). Les résultats agrégés sont visibles par tout
// compte connecté ; seul le VOTE est réservé Premium (voir PollVote et
// /api/community/polls/[id]/vote).
model Poll {
  id        String       @id @default(cuid())
  question  String
  createdAt DateTime     @default(now())
  closesAt  DateTime?
  options   PollOption[]
  votes     PollVote[]

  @@index([createdAt])
}

model PollOption {
  id     String     @id @default(cuid())
  pollId String
  label  String
  order  Int        @default(0)
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes  PollVote[]

  @@index([pollId])
}

// Un seul vote par utilisateur et par sondage (contrainte pollId_userId,
// voir /api/community/polls/[id]/vote) : revoter avec une autre option
// remplace le vote précédent via upsert plutôt que d'en créer un second.
model PollVote {
  id        String     @id @default(cuid())
  pollId    String
  optionId  String
  userId    String
  createdAt DateTime   @default(now())
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([optionId])

  // Index (lot 3, qualité) : clés étrangères et filtres fréquents — Postgres
  // n'indexe pas les clés étrangères tout seul.
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Croissance (brief growth du 23/09/2026) — mesure interne, sans tiers.
// ---------------------------------------------------------------------------

// Événement léger d'acquisition/conversion (badge_click, landing_view,
// paid, upgrade_modal_shown…). Jamais de donnée personnelle dans `meta`
// pour les événements venus des pages publiques (/api/growth). Purgé au
// bout de 180 jours par /api/cron. Lu par /admin/acquisition.
model GrowthEvent {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  meta      Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([name, createdAt])
  @@index([userId])
}

// Email de cycle de vie déjà envoyé — une clé par adresse, jamais deux fois
// (voir src/lib/emails/lifecycle.ts et runLifecycleEmails()).
model LifecycleEmail {
  id     String   @id @default(cuid())
  userId String?
  email  String
  key    String
  sentAt DateTime @default(now())
  user   User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([email, key])
  @@index([email, sentAt])

  // Index (lot 3, qualité) : clés étrangères et filtres fréquents — Postgres
  // n'indexe pas les clés étrangères tout seul.
  @@index([userId])
}

// Studio IA (produit n°9, page /studio) : idées + accroches, ou script de
// vidéo, écrits par Gemini à partir de ce qui marche déjà pour la marque.
// Historique gardé (50 derniers par marque) : revoir un résultat ne coûte
// aucune génération. Quota par jour et par compte : Pro 15, Agence 40
// (compté sur ces lignes). `sources` = les publications citées, avec leurs
// chiffres au moment de la génération (jamais tirés du texte de l'IA).
model StudioGeneration {
  id        String   @id @default(cuid())
  brandId   String
  userId    String
  kind      String // "ideas" | "script"
  input     Json
  output    Json
  sources   Json?
  createdAt DateTime @default(now())
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([brandId, createdAt])
  @@index([userId, createdAt])
}

// Media kit public (produit n°10, /kit/[slug]) : la page que le créateur
// envoie aux marques et aux sponsors. Une ligne par marque, créée au premier
// accès à l'éditeur (/media-kit). Les CHIFFRES ne sont jamais stockés ici :
// ils sont recalculés depuis AnalyticsSnapshot et PostMetric (relevés par les
// API officielles), et le créateur ne peut pas les modifier ; il choisit
// seulement les comptes et les publications affichés, et écrit le texte.
// Publier est réservé aux paliers Pro et Agence (mediaKitEnabled).
model MediaKit {
  id                 String    @id @default(cuid())
  brandId            String    @unique
  brand              Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  published          Boolean   @default(false)
  headline           String    @default("")
  about              String    @default("")
  contactEmail       String?
  // Identifiants de SocialConnection masqués sur le kit (tous affichés par défaut).
  hiddenConnectionIds Json     @default("[]")
  // Identifiants de PostMetric mis en avant, dans l'ordre ; vide = choix automatique.
  featuredPostIds    Json      @default("[]")
  // Offres : [{ label, price }] (6 au plus), texte libre du créateur.
  offers             Json      @default("[]")
  // Ouvertures du kit (un visiteur compté une fois par jour, sans cookie ;
  // les membres de la marque ne comptent pas).
  views              Int       @default(0)
  lastViewedAt       DateTime?
  publishedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// Audit de présence en ligne (produit n°8, outil public /outils/audit) :
// rapport partageable par lien secret (/audit/[token]), fait uniquement de
// données publiques. Conservé 30 jours (purge par le cron), supprimable par
// quiconque a le lien. Ni adresse e-mail ni IP en clair (empreinte de l'IP
// pour le quota). Mêmes comptes dans les 24 h : le rapport existant est
// resservi (inputKey). `result` suit AuditResult (src/lib/audit/types.ts),
// `advice` les paragraphes de Gemini, écrits après coup (2 essais au plus).
model PublicAudit {
  id             String    @id @default(cuid())
  token          String    @unique
  inputKey       String
  input          Json
  result         Json
  score          Int?
  // Sources lues avec succès (« youtube,website »).
  sources        String
  advice         Json?
  adviceAttempts Int       @default(0)
  ipHash         String
  emailSentAt    DateTime?
  createdAt      DateTime  @default(now())
  expiresAt      DateTime

  @@index([inputKey, createdAt])
  @@index([expiresAt])
}

// Résultat d'un outil gratuit (légende, miniature…) mis de côté le temps
// que le visiteur crée un compte : « Programmer cette publication avec
// Nebula » → /register?next=/composer?draft=<id>. Expire en 7 jours (purge
// par le cron), supprimé dès qu'il est consommé par le Composer.
model PublicDraft {
  id        String   @id @default(cuid())
  kind      String   // "CAPTION" | "THUMBNAIL"
  content   Json
  network   String?
  ipHash    String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

// Lead capturé sur les outils gratuits (« Recevez 5 générations de plus par
// jour ») — alimente la séquence lead_* des emails de cycle de vie tant
// qu'aucun compte n'existe avec la même adresse.
model ToolLead {
  id        String   @id @default(cuid())
  email     String
  tool      String
  consent   Boolean  @default(false)
  ipHash    String?
  createdAt DateTime @default(now())
  // Double confirmation (audit sécurité, lot 1) : avant, n'importe qui
  // pouvait inscrire l'adresse d'un tiers et lui faire envoyer 3 e-mails.
  // confirmationSentAt : e-mail « Confirmez votre inscription » envoyé ;
  // la séquence de conseils ne part qu'après le clic (confirmedAt). Les
  // leads antérieurs (les deux dates vides) gardent l'ancien fonctionnement.
  confirmationSentAt DateTime?
  confirmedAt        DateTime?

  @@index([email])
  @@index([createdAt])
}

// Liste d'attente par réseau non encore supporté (/reseaux/[slug]).
model NetworkWaitlist {
  id        String   @id @default(cuid())
  email     String
  network   String
  consent   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([email, network])
  @@index([network])
}

// Centre de notifications (25/09/2026) : la cloche de l'en-tête (voir
// src/components/dashboard/notification-bell.tsx et src/lib/notifications.ts).
// Quelques lignes de texte par notification, purgées au bout de 90 jours par
// le cron. dedupeKey (facultatif) évite de répéter la même alerte (ex. un
// compte à reconnecter) : unique par compte, plusieurs NULL autorisés.
model Notification {
  id          String    @id @default(cuid())
  userId      String
  // publish_ok | publish_failed | approval | reconnect | reminder | achievement | referral | news
  kind        String
  // Onglet de la bulle : "pub" (publications), "win" (succès et récompenses), "news" (actus).
  category    String
  title       String
  body        String
  href        String?
  actionLabel String?
  dedupeKey   String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
}

// Récompenses de parrainage (25/09/2026, voir src/lib/billing/rewards.ts) :
// une ligne par compte devenu payant et par motif. Créée au premier VRAI
// paiement (facture > 0 €) du filleul, en attente 30 jours (eligibleAt),
// puis accordée par le cron si le filleul est toujours abonné — dans la
// limite de 12 mois offerts sur 12 mois glissants par bénéficiaire. Au-delà,
// statut CAPPED : pas de mois, mais la ligne compte pour les paliers
// ambassadeur. Pas de relation vers User : deux comptes différents y
// figurent, et une ligne orpheline est simplement ignorée.
model ReferralReward {
  id            String    @id @default(cuid())
  beneficiaryId String
  refereeId     String
  // "referral" (lien de parrainage) | "badge" (badge « Propulsé par Nebula »)
  reason        String
  // PENDING | GRANTED | CAPPED | CANCELED
  status        String    @default("PENDING")
  eligibleAt    DateTime
  grantedAt     DateTime?
  // credit (solde Stripe) | coupon | bonus (déduit à la prochaine souscription)
  mode          String?
  brandSlug     String?
  refereeName   String?
  createdAt     DateTime  @default(now())

  @@unique([refereeId, reason])
  @@index([beneficiaryId, status])
  @@index([status, eligibleAt])
}

// Comptes d'outils externes reliés pour IMPORTER des médias dans Publier
// (lot 3, 25/09/2026) : Canva et OneDrive, qui passent par une connexion
// OAuth propre à chaque personne. Google Drive (Google Picker), Dropbox
// (Dropbox Chooser) et Unsplash n'ont besoin d'aucun jeton enregistré.
// Voir src/lib/integrations/*.ts.
model IntegrationAccount {
  id           String    @id @default(cuid())
  userId       String
  // "canva" | "onedrive"
  provider     String
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  displayName  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

// API publique et webhooks (lot 4, palier Agence, 25/09/2026) — voir
// src/lib/api/*.ts et la page /automatisations.
//
// Clé d'API : seul son empreinte SHA-256 est stockée (la clé complète n'est
// montrée qu'une fois, à la création). prefix = début de la clé, pour la
// reconnaître dans la liste. scopes : "read" ou "read,write". brandId :
// limite la clé à une marque (null = toutes les marques du compte).
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  prefix     String
  keyHash    String    @unique
  scopes     String    @default("read")
  brandId    String?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Adresse appelée à chaque événement choisi (publication en ligne, échec,
// validation client…). secret : clé de signature HMAC des envois (en-tête
// Nebula-Signature). Désactivée automatiquement après 15 échecs d'affilée.
model WebhookEndpoint {
  id             String            @id @default(cuid())
  userId         String
  brandId        String?
  url            String
  description    String?
  events         String[]
  secret         String
  active         Boolean           @default(true)
  failureCount   Int               @default(0)
  lastDeliveryAt DateTime?
  lastStatus     Int?
  disabledReason String?
  createdAt      DateTime          @default(now())
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries     WebhookDelivery[]

  @@index([userId])
}

// Journal des envois (30 jours) et file des relances : PENDING tant qu'il
// reste des tentatives (nextAttemptAt), puis SUCCESS ou FAILED.
model WebhookDelivery {
  id             String          @id @default(cuid())
  endpointId     String
  event          String
  payload        String
  status         String          @default("PENDING")
  attempts       Int             @default(0)
  responseStatus Int?
  error          String?
  nextAttemptAt  DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime        @default(now())
  endpoint       WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
}

// Suivi publicitaire (lot 5, paliers Pro et Agence, 25/09/2026) — Google
// Ads, Meta Ads, TikTok Ads : dépenses et résultats dans Analytics → onglet
// « Publicité ». Voir src/lib/ads/*.ts. Pas de relation Prisma vers Brand
// (lignes orphelines ignorées) pour garder l'ajout 100 % additif.
//
// platform : "GOOGLE_ADS" | "META_ADS" | "TIKTOK_ADS". externalId :
// numéro de client Google (sans tirets), identifiant de compte Meta (sans
// « act_ ») ou identifiant d'annonceur TikTok. loginCustomerId : compte
// administrateur Google par lequel on accède à ce client (en-tête
// login-customer-id), sinon null.
model AdAccount {
  id              String    @id @default(cuid())
  brandId         String
  platform        String
  externalId      String
  name            String
  currency        String    @default("EUR")
  accessToken     String
  refreshToken    String?
  tokenExpiresAt  DateTime?
  loginCustomerId String?
  status          String    @default("CONNECTED")
  lastError       String?
  // Dernière synchro RÉUSSIE (null = historique de 90 jours pas encore chargé).
  lastSyncedAt    DateTime?
  // Prochain passage du cron (toutes les 12 h, plus tôt après une erreur passagère).
  nextSyncAt      DateTime  @default(now())
  // Campagnes des 30 derniers jours (JSON), remplacées à chaque synchro.
  campaigns       String?
  connectedAt     DateTime  @default(now())
  brand           Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  metrics         AdMetricDaily[]

  @@unique([brandId, platform, externalId])
  @@index([brandId])
  @@index([nextSyncAt])
}

// Chiffres d'une journée pour un compte publicitaire (dépense dans la devise
// du compte).
model AdMetricDaily {
  id          String   @id @default(cuid())
  adAccountId String
  date        DateTime
  spend       Float    @default(0)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  conversions Float    @default(0)
  reach       Int?
  adAccount   AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)

  @@unique([adAccountId, date])
  @@index([adAccountId, date])
}

// Autorisation reçue d'une régie, en attente du choix des comptes à relier
// à la marque (1 h au plus, puis supprimée par le cron).
model PendingAdAuth {
  id             String    @id @default(cuid())
  userId         String
  brandId        String
  platform       String
  accessToken    String
  refreshToken   String?
  tokenExpiresAt DateTime?
  accounts       String
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// --- Réussites (25/09/2026) ---------------------------------------------
// Accomplissement débloqué (un palier = une ligne, ex. « posts-50 ») ou
// niveau atteint (« level-5 », 0 XP). L'XP est figée au moment du déblocage :
// changer le barème plus tard ne retire rien à personne.
model AchievementUnlock {
  id           String    @id @default(cuid())
  userId       String
  key          String
  xp           Int       @default(0)
  unlockedAt   DateTime  @default(now())
  // Célébration (carte + confettis) déjà montrée à l'écran.
  celebratedAt DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId, unlockedAt])
}

// Missions de la semaine (Réussites v2, 26/09/2026) : une ligne par compte
// et par semaine, créée à la première évaluation de la semaine. Le choix est
// figé pour la semaine : Habitude (objectif réglé sur le rythme du compte),
// Progression (choisie parmi 3, un changement permis), Mystère (révélée
// quand les deux autres sont faites, ou le jeudi). Les missions réussies
// sont des ChallengeCompletion de kind « MISSION » (challengeKey
// « mission-habit » / « mission-progress » / « mission-mystery ») ; le
// coffre ouvert, une ChallengeCompletion de kind « CHEST ».
model WeeklyMissions {
  id            String    @id @default(cuid())
  userId        String
  week          String
  habitKey      String
  habitTarget   Int
  choices       String[]
  progressKey   String
  swapsUsed     Int       @default(0)
  mysteryKey    String
  revealedAt    DateTime?
  chestOpenedAt DateTime?
  chestItem     String?
  // Bilan de la semaine (lot B) : fait le…, et le cap choisi pour la
  // semaine (« format », « slot », « rhythm » ou « new »).
  reviewedAt    DateTime?
  reviewFocus   String?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, week])
}

// Objets des Réussites (boucliers de série, fragments d'étoile filante) :
// un mouvement par ligne (+1 gagné, -1 utilisé), le solde est la somme.
// reason est unique par compte : un même gain ou une même dépense ne peut
// jamais être compté deux fois (« chest:2026-W39 », « streak:2917:8 »,
// « protect:2918 »).
model ReussiteItem {
  id        String   @id @default(cuid())
  userId    String
  item      String
  qty       Int
  reason    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reason])
  @@index([userId, item])
}

// Défi de la semaine ou du mois réussi. period = « 2026-W39 » ou « 2026-09 ».
model ChallengeCompletion {
  id           String    @id @default(cuid())
  userId       String
  period       String
  challengeKey String
  kind         String
  xp           Int       @default(0)
  completedAt  DateTime  @default(now())
  celebratedAt DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period, challengeKey])
  @@index([userId, completedAt])
}

// Demandes de suppression de données reçues de Meta (lot 2) : Facebook,
// Instagram ou Threads appellent /api/meta/data-deletion quand une personne
// supprime l'application de ses paramètres et demande l'effacement de ses
// données. L'identifiant est le code de confirmation montré à la personne
// (page /suppression-donnees?code=…).
model DataDeletionRequest {
  id          String    @id
  provider    String
  status      String    @default("RECEIVED")
  connections Int       @default(0)
  createdAt   DateTime  @default(now())
  completedAt DateTime?
}

// Interrupteurs par réseau et disjoncteur (lot 5, résilience des API).
// Une ligne par réseau, créée à la première utilisation. Pilotable depuis
// /admin/reseaux sans redéploiement :
//  - publishEnabled / syncEnabled : suspendre la publication ou la synchro
//    des statistiques sur un réseau (incident, changement d'API…) ; les
//    publications en attente repartent seules à la réactivation ;
//  - disjoncteur automatique : après plusieurs pannes rapprochées chez le
//    réseau, les envois sont mis en pause quelques minutes (trippedUntil)
//    au lieu d'échouer les uns après les autres.
model NetworkControl {
  network             String    @id
  publishEnabled      Boolean   @default(true)
  syncEnabled         Boolean   @default(true)
  // Message montré aux utilisateurs pendant une suspension manuelle.
  message             String?
  failureCount        Int       @default(0)
  failureWindowStart  DateTime?
  trippedUntil        DateTime?
  lastFailureAt       DateTime?
  lastFailureCategory String?
  lastFailureMessage  String?
  lastSuccessAt       DateTime?
  updatedAt           DateTime  @updatedAt
}
