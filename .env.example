# ---------------------------------------------------------------------------
# NEBULA — variables d'environnement
# Copiez ce fichier en ".env" puis remplissez les valeurs.
# Rien de tout cela n'est fourni par Nebula : chaque clé vient du portail
# développeur officiel du réseau concerné, sous VOTRE compte.
# ---------------------------------------------------------------------------

# --- Base de données ---
# Dev local (SQLite, aucune installation requise) :
DATABASE_URL="file:./dev.db"
# En production, remplacez par une base Postgres, ex (Railway/Supabase/Neon) :
# DATABASE_URL="postgresql://neondb_owner:npg_gD4YZ0oRkwKy@ep-bitter-dawn-b1ozj79v-pooler.c-5.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# --- Auth (NextAuth) ---
NEXTAUTH_SECRET="générez avec: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# --- Meta (Instagram + Facebook) — https://developers.facebook.com/apps ---
# Nécessite une App Meta en mode "Live", un compte Business vérifié, et les
# permissions instagram_content_publish / pages_manage_posts validées en App Review.
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI="http://localhost:3000/api/connections/meta/callback"

# --- TikTok — https://developers.tiktok.com/apps ---
# Le scope video.publish est en accès restreint : votre app doit être
# auditée par TikTok avant de pouvoir publier sur des comptes autres que
# les vôtres (mode "unaudited" = publication limitée à vos comptes test).
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REDIRECT_URI="http://localhost:3000/api/connections/tiktok/callback"

# --- YouTube (Google Cloud) — https://console.cloud.google.com ---
# Activez "YouTube Data API v3", créez des identifiants OAuth 2.0.
# Le quota par défaut est 10 000 unités/jour (un upload en coûte ~1 600) ;
# une validation OAuth Google est requise pour sortir du mode test.
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REDIRECT_URI="http://localhost:3000/api/connections/youtube/callback"

# --- X (Twitter) et LinkedIn : non disponibles sur cette instance ---
# X nécessite un plan API payant pour publier/lire, et LinkedIn nécessite une
# entité entreprise vérifiée — voir la page "Soutenir Nebula" dans
# l'application pour le détail de ce qui est prévu quand le site générera
# des revenus. Retirés du code pour ne rien promettre de cassé.

# --- Stockage des médias uploadés ---
# En local, les fichiers sont stockés sur disque (./public/uploads).
UPLOAD_DIR="./public/uploads"
# Sur Vercel (ou tout hébergeur serverless), le disque n'est pas persistant :
# renseignez BLOB_READ_WRITE_TOKEN pour que les uploads partent automatiquement
# vers Vercel Blob à la place (créez un Blob Store dans votre projet Vercel :
# Storage → Create Database → Blob, le token est généré et affiché aussitôt).
# Tant qu'elle est vide, le stockage disque local reste utilisé.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_KmyMgV0m5KV4hS2w_gv9WX8mjoS5i8AylbfsT53Jk3vewMO"

# --- Sécurité du worker planifié ---
CRON_SECRET="générez une chaîne aléatoire pour protéger /api/cron"

# --- IA (optionnel) — Google Gemini, palier gratuit disponible ---
# Clé gratuite : https://aistudio.google.com/apikey
# Tant que cette clé est absente, tous les boutons IA restent simplement
# masqués dans l'interface — aucune obligation, aucun coût.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# --- Abonnements (optionnel) — Stripe ---
# https://dashboard.stripe.com/apikeys — tant que STRIPE_SECRET_KEY est
# absent, la page Facturation affiche les paliers à titre indicatif mais
# n'accepte aucun paiement (aucun coût, aucune obligation).
# L'abonnement est rattaché au COMPTE (pas à une marque précise) et le
# client choisit, pour Pro comme pour Agence, COMBIEN de marques il veut
# pouvoir gérer — le prix augmente avec ce nombre (voir src/lib/plans.ts).
STRIPE_SECRET_KEY=""
# Il faut donc créer DEUX tarifs récurrents (mensuel + annuel) PAR PALIER DE
# NOMBRE DE MARQUES, soit 12 tarifs au total (3 paliers Pro × 2 intervalles +
# 3 paliers Agence × 2 intervalles). Les montants par défaut sont dans
# src/lib/plans.ts (l'annuel y est déjà fixé à priceMonthly*10, ~2 mois
# offerts) ; copiez chaque Price ID (price_...) Stripe ci-dessous :
STRIPE_PRICE_PRO_3_MONTHLY="price_1UHQnPPGVCI5xJPoPWRdNBNn"
STRIPE_PRICE_PRO_3_YEARLY="price_1UHQouPGVCI5xJPozlILE91B"
STRIPE_PRICE_PRO_5_MONTHLY="price_1UHQpKPGVCI5xJPowqIESwW2"
STRIPE_PRICE_PRO_5_YEARLY="price_1UHQsdPGVCI5xJPodMEAFtjL"
STRIPE_PRICE_PRO_10_MONTHLY="price_1UHQttPGVCI5xJPo0gOa2ykF"
STRIPE_PRICE_PRO_10_YEARLY="price_1UHQuHPGVCI5xJPoMfZplVnO"
STRIPE_PRICE_AGENCY_15_MONTHLY="price_1UHQuzPGVCI5xJPoXoe44K5d"
STRIPE_PRICE_AGENCY_15_YEARLY="price_1UHQvLPGVCI5xJPoOE2LuhhB"
STRIPE_PRICE_AGENCY_25_MONTHLY="price_1UHQvkPGVCI5xJPoQhYiQFggc"
STRIPE_PRICE_AGENCY_25_YEARLY="price_1UHQw2PGVCI5xJPo2LkPf0kG"
STRIPE_PRICE_AGENCY_50_MONTHLY="price_1UHQwQPGVCI5xJPoIpI6NUVb"
STRIPE_PRICE_AGENCY_50_YEARLY="price_1UHQwzPGVCI5xJPoBIxTPcxl"

# --- Soutenir Nebula (optionnel) ---
# Lien de don affiché sur la page "Soutenir Nebula" (Ko-fi, Buy Me a Coffee,
# PayPal.me, Stripe Payment Link...). Tant qu'il est vide, la page l'indique
# honnêtement et n'affiche aucun bouton de paiement.
NEXT_PUBLIC_DONATE_URL=""
