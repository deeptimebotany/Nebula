# ---------------------------------------------------------------------------
# NEBULA — variables d'environnement
# Copiez ce fichier en ".env" puis remplissez les valeurs.
# Rien de tout cela n'est fourni par Nebula : chaque clé vient du portail
# développeur officiel du réseau concerné, sous VOTRE compte.
# ---------------------------------------------------------------------------

# --- Base de données ---
# Dev local (SQLite, aucune installation requise) :
DATABASE_URL="file:./dev.db"
# En production, remplacez par une base Postgres, ex (Railway/Supabase/Neon) :
# DATABASE_URL="postgresql://user:password@host:5432/nebula"

# --- Adresse publique du site (optionnel) ---
# Utilisée pour les liens absolus (sitemap, image de partage OpenGraph,
# balise canonique). Par défaut : https://nebulahub.space (voir src/lib/site.ts).
# À renseigner uniquement si le site est servi sous une autre adresse.
NEXT_PUBLIC_SITE_URL=""
# Adresse de contact affichée sur le site (footer, pages légales). Par défaut
# l'adresse du propriétaire ; à remplacer par une adresse sur le domaine.
NEXT_PUBLIC_CONTACT_EMAIL=""
# Mentions légales (voir /legal et src/lib/site.ts) — à renseigner dès que la
# micro-entreprise est immatriculée. Tant que c'est vide, la page indique
# « en cours d'immatriculation ».
NEXT_PUBLIC_LEGAL_NAME=""
NEXT_PUBLIC_LEGAL_FORM="Entrepreneur individuel (micro-entreprise)"
NEXT_PUBLIC_LEGAL_SIREN=""
NEXT_PUBLIC_LEGAL_ADDRESS=""
NEXT_PUBLIC_LEGAL_DIRECTOR=""

# --- Auth (NextAuth) ---
NEXTAUTH_SECRET="générez avec: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# --- Connexion rapide Google / Apple (optionnel) ---
# Tant que ces variables sont absentes, les boutons "Continuer avec
# Google/Apple" restent simplement masqués sur /login et /register — le
# reste du site fonctionne normalement avec email + mot de passe.
# Google : https://console.cloud.google.com/apis/credentials → créez un
# "ID client OAuth" de type "Application Web", ajoutez comme URI de
# redirection autorisé : http://localhost:3000/api/auth/callback/google
# (et l'équivalent avec votre domaine en production).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Apple : https://developer.apple.com/account/resources/identifiers (nécessite
# un compte Apple Developer payant, 99$/an) → créez un Service ID, puis une
# clé "Sign in with Apple" (.p8). APPLE_CLIENT_SECRET n'est PAS le secret
# affiché tel quel : Apple exige un JWT signé avec cette clé, à régénérer
# régulièrement (valide 6 mois max) — voir la doc NextAuth "Apple Provider"
# pour le script de génération. URI de redirection à autoriser :
# https://votredomaine.com/api/auth/callback/apple
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""
# Meta ("Continuer avec Meta" — connexion au COMPTE Nebula lui-même) : ATTENTION,
# distinct de META_APP_ID/META_APP_SECRET plus bas, qui servent à CONNECTER un
# compte Instagram/Page Facebook pour PUBLIER — vous pouvez réutiliser la même
# app Meta pour les deux, il suffit d'activer le produit "Facebook Login"
# dessus en plus d'"Instagram Graph API". URI de redirection à autoriser :
# http://localhost:3000/api/auth/callback/facebook (+ votre domaine en prod).
# Les permissions par défaut (email, profil public) n'exigent PAS d'App Review
# — seulement que l'app soit passée en mode "Live" dans Meta for Developers.
# Tant que l'app est en mode "Développement", seuls les comptes ajoutés comme
# Admin/Développeur/Testeur sur l'app peuvent utiliser ce bouton.
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# --- Meta (Instagram + Facebook) — https://developers.facebook.com/apps ---
# Nécessite une App Meta en mode "Live", un compte Business vérifié, et les
# permissions instagram_content_publish / pages_manage_posts validées en App Review.
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI="http://localhost:3000/api/connections/meta/callback"

# --- TikTok — https://developers.tiktok.com/apps ---
# Le scope video.publish est en accès restreint : votre app doit être
# auditée par TikTok avant de pouvoir publier sur des comptes autres que
# les vôtres (mode "unaudited" = publication limitée à vos comptes test).
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REDIRECT_URI="http://localhost:3000/api/connections/tiktok/callback"

# --- YouTube (Google Cloud) — https://console.cloud.google.com ---
# Activez "YouTube Data API v3", créez des identifiants OAuth 2.0.
# Le quota par défaut est 10 000 unités/jour (un upload en coûte ~1 600) ;
# une validation OAuth Google est requise pour sortir du mode test.
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REDIRECT_URI="http://localhost:3000/api/connections/youtube/callback"

# --- Bluesky ---
# Aucune clé à configurer : chaque personne se connecte avec un « mot de passe
# d'application » créé dans ses réglages Bluesky (voir src/lib/social/bluesky.ts).

# --- Lot 2 (Threads, Pinterest, LinkedIn) ---
# Chaque réseau reste INVISIBLE dans l'application tant que ses deux clés ne
# sont pas renseignées (voir src/lib/network-availability.ts). Les URL de
# retour sont calculées depuis NEXTAUTH_URL (…/api/connections/<réseau>/callback) ;
# les variables *_REDIRECT_URI permettent de les forcer si besoin.
# Pour les annoncer aussi sur les pages publiques : LAUNCHED_NETWORKS dans src/lib/types.ts.

# Threads — developers.facebook.com : cas d'usage « Accéder à l'API Threads »
# dans l'app Meta. Identifiant et clé secrète de l'app THREADS (différents de
# META_APP_ID). Permissions à valider en App Review : threads_basic,
# threads_content_publish, threads_manage_insights, threads_manage_replies,
# threads_read_replies. Avant validation : comptes testeurs uniquement.
THREADS_APP_ID=""
THREADS_APP_SECRET=""
# THREADS_REDIRECT_URI="https://votre-site/api/connections/threads/callback"

# Pinterest — developers.pinterest.com (compte professionnel). Accès d'essai :
# épingles visibles par vous seul ; demandez ensuite l'accès « Standard ».
PINTEREST_APP_ID=""
PINTEREST_APP_SECRET=""
# PINTEREST_REDIRECT_URI="https://votre-site/api/connections/pinterest/callback"

# LinkedIn — linkedin.com/developers : app rattachée à une Page LinkedIn, avec
# les produits « Sign In with LinkedIn using OpenID Connect » et « Share on
# LinkedIn » (gratuits, sans validation). Profils personnels uniquement ; les
# Pages entreprise demandent la Community Management API.
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
# LINKEDIN_REDIRECT_URI="https://votre-site/api/connections/linkedin/callback"
# LINKEDIN_API_VERSION="202607"   # facultatif (AAAAMM), sinon calculée automatiquement

# --- Lot 3 : import de médias dans Publier ---
# Chaque source n'apparaît dans la barre « Importer depuis » que si ses clés
# sont renseignées. Toutes gratuites.

# Google Drive (Google Picker) — console.cloud.google.com, même projet que la
# connexion Google si tu veux : activer « Google Picker API » et « Google
# Drive API », créer une clé d'API restreinte à ton domaine, et ajouter ton
# domaine aux « Origines JavaScript autorisées » du client OAuth. Le scope
# drive.file (fichiers choisis uniquement) n'impose pas d'audit de sécurité.
# APP_ID = numéro du projet Google Cloud (Paramètres du projet).
GOOGLE_PICKER_API_KEY=""
GOOGLE_PICKER_APP_ID=""
# GOOGLE_PICKER_CLIENT_ID=""   # facultatif : sinon GOOGLE_CLIENT_ID est utilisé

# Dropbox (Dropbox Chooser) — dropbox.com/developers/apps : créer une app,
# ajouter ton domaine dans « Chooser / Saver / Embedder domains ».
DROPBOX_APP_KEY=""

# OneDrive — portal.azure.com → Microsoft Entra ID → Inscriptions
# d'applications : comptes personnels + professionnels, URL de retour Web
# <site>/api/integrations/onedrive/callback, un secret client, autorisations
# déléguées Files.Read, User.Read, offline_access.
ONEDRIVE_CLIENT_ID=""
ONEDRIVE_CLIENT_SECRET=""

# Unsplash — unsplash.com/developers : créer une application (mode démo :
# 50 requêtes/heure), puis demander le passage en production (gratuit).
UNSPLASH_ACCESS_KEY=""
# UNSPLASH_APP_NAME="nebula"   # utilisé dans les liens de crédit (utm_source)

# Canva — canva.com/developers : intégration « Connect API », scopes
# design:meta:read, design:content:read, profile:read, URL de retour
# <site>/api/integrations/canva/callback. Avant validation par Canva, seul
# le créateur de l'intégration peut la relier.
CANVA_CLIENT_ID=""
CANVA_CLIENT_SECRET=""

# --- Lot 5 : suivi publicitaire (onglet « Publicité » d'Analytics) ---
# Pro (3 comptes pub par marque) et Agence (50). Nebula LIT les chiffres
# (dépenses, impressions, clics, conversions, campagnes) et ne modifie
# jamais une campagne. Chaque régie n'apparaît que si ses clés sont
# renseignées ; les trois API sont gratuites. Synchro toutes les 12 h par
# le cron (/api/cron), 90 jours d'historique à la connexion.

# Google Ads — 1) un compte administrateur Google Ads (MCC, gratuit) ;
# 2) dans ce MCC : Outils → Centre API → « jeton de développeur », puis
# demander l'accès « Basic » (formulaire, quelques jours ; sans lui seuls
# les comptes de TEST répondent) ; 3) console.cloud.google.com : activer
# « Google Ads API » dans le projet, ajouter l'URL de retour
# <site>/api/ads/callback/google au client OAuth, et le scope
# .../auth/adwords à l'écran de consentement (sensible → vérification).
GOOGLE_ADS_DEVELOPER_TOKEN=""
# GOOGLE_ADS_CLIENT_ID=""       # facultatif : sinon GOOGLE_CLIENT_ID
# GOOGLE_ADS_CLIENT_SECRET=""   # facultatif : sinon GOOGLE_CLIENT_SECRET
# GOOGLE_ADS_API_VERSION="v25"  # à monter quand Google retire la version (~1 an)

# Meta Ads — même application Meta qu'Instagram/Facebook : ajouter le cas
# d'usage « API Marketing », l'URL de retour <site>/api/ads/callback/meta,
# et demander la permission ads_read en accès avancé (App Review, avec
# vidéo). Mettre "true" une fois validée : avant, seuls les comptes pub des
# administrateurs de l'app fonctionneraient.
META_ADS_ENABLED=""
# META_ADS_GRAPH_VERSION="v25.0"

# TikTok Ads — business-api.tiktok.com → « Become a developer », créer une
# app « Marketing API » (≠ l'app TikTok de publication), cocher les
# autorisations « Ad Account Management » (lecture) et « Reporting », URL
# de retour <site>/api/ads/callback/tiktok. Validation par TikTok (1 à 3
# jours ouvrés).
TIKTOK_ADS_APP_ID=""
TIKTOK_ADS_APP_SECRET=""

# --- X (Twitter) : non disponible ---
# L'API de X est payante à l'usage pour publier : prévue dans l'encadré
# « Bientôt disponible » de la page Soutenir Nebula.

# --- Stockage des médias uploadés ---
# En local, les fichiers sont stockés sur disque (./public/uploads).
UPLOAD_DIR="./public/uploads"
# Sur Vercel (ou tout hébergeur serverless), le disque n'est pas persistant :
# renseignez BLOB_READ_WRITE_TOKEN pour que les uploads partent automatiquement
# vers Vercel Blob à la place (créez un Blob Store dans votre projet Vercel :
# Storage → Create Database → Blob, le token est généré et affiché aussitôt).
# Tant qu'elle est vide, le stockage disque local reste utilisé.
# IMPORTANT : cette variable doit aussi être ajoutée sur Vercel lui-même
# (Project Settings → Environment Variables), pas seulement dans ce fichier
# .env local — sinon les uploads échouent une fois le site en ligne, même
# si tout fonctionne en local. Si vous créez le Blob Store directement
# depuis l'onglet "Storage" du projet Vercel et le connectez au projet,
# Vercel ajoute la variable automatiquement.
BLOB_READ_WRITE_TOKEN=""

# --- Sécurité du worker planifié ---
# OBLIGATOIRE en production : sans cette variable, /api/cron refuse toutes
# les requêtes (503) — les publications programmées et les rapports
# automatiques ne partent donc pas tant qu'elle n'est pas renseignée sur
# Vercel ET dans votre scheduler (en-tête "Authorization: Bearer <valeur>").
CRON_SECRET="générez une chaîne aléatoire pour protéger /api/cron"

# --- Envoi d'email (réinitialisation de mot de passe) ---
# Créez un compte gratuit sur https://resend.com, puis Dashboard → API Keys
# pour générer RESEND_API_KEY. Sans domaine vérifié, EMAIL_FROM peut rester
# "Nebula <onboarding@resend.dev>" (fonctionne tout de suite, ~100 emails/jour
# gratuits — largement suffisant pour des emails de mot de passe).
# Tant que RESEND_API_KEY est absent, "Mot de passe oublié" ne pourra pas
# envoyer d'email (le reste du site continue de fonctionner normalement).
RESEND_API_KEY=""
EMAIL_FROM="Nebula <onboarding@resend.dev>"

# --- Protection anti-robot (inscription / mot de passe oublié) ---
# Cloudflare Turnstile — gratuit, sans grille d'images à résoudre pour la
# plupart des visiteurs. Créez un site sur :
# https://dash.cloudflare.com/?to=/:account/turnstile puis copiez les deux
# clés générées. NEXT_PUBLIC_TURNSTILE_SITE_KEY est publique (visible dans
# le navigateur, c'est normal) ; TURNSTILE_SECRET_KEY doit rester secrète.
# Tant que ces deux variables sont absentes, le site fonctionne normalement
# mais sans protection anti-robot (le widget ne s'affiche simplement pas).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- IA (optionnel) — Google Gemini, palier gratuit disponible ---
# Clé gratuite : https://aistudio.google.com/apikey
# Tant que cette clé est absente, tous les boutons IA restent simplement
# masqués dans l'interface — aucune obligation, aucun coût.
GEMINI_API_KEY=""
# Modèle texte (assistant, titres, descriptions…). Laissez VIDE pour utiliser
# le modèle par défaut du code (gemini-3.6-flash) : Google retire
# régulièrement les anciens noms (gemini-2.5-flash a été retiré pour les
# nouvelles clés le 19/09/2026). Ne renseignez ici un nom que si l'API vous
# indique explicitement un nouveau modèle à utiliser.
GEMINI_MODEL=""
# Modèle image (miniatures IA, stickers). Même logique : vide = défaut du code.
GEMINI_IMAGE_MODEL=""

# --- Abonnements (optionnel) — Stripe ---
# https://dashboard.stripe.com/apikeys — tant que STRIPE_SECRET_KEY est
# absent, la page Facturation affiche les paliers à titre indicatif mais
# n'accepte aucun paiement (aucun coût, aucune obligation).
# L'abonnement est rattaché au COMPTE (pas à une marque précise) et le
# client choisit, pour Pro comme pour Agence, COMBIEN de marques il veut
# pouvoir gérer — le prix augmente avec ce nombre (voir src/lib/plans.ts).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Il faut donc créer DEUX tarifs récurrents (mensuel + annuel) PAR PALIER DE
# NOMBRE DE MARQUES, soit 12 tarifs au total (3 paliers Pro × 2 intervalles +
# 3 paliers Agence × 2 intervalles). Les montants par défaut sont dans
# src/lib/plans.ts (l'annuel y est déjà fixé à priceMonthly*10, ~2 mois
# offerts) ; copiez chaque Price ID (price_...) Stripe ci-dessous :
STRIPE_PRICE_PRO_3_MONTHLY=""
STRIPE_PRICE_PRO_3_YEARLY=""
STRIPE_PRICE_PRO_5_MONTHLY=""
STRIPE_PRICE_PRO_5_YEARLY=""
STRIPE_PRICE_PRO_10_MONTHLY=""
STRIPE_PRICE_PRO_10_YEARLY=""
STRIPE_PRICE_AGENCY_15_MONTHLY=""
STRIPE_PRICE_AGENCY_15_YEARLY=""
STRIPE_PRICE_AGENCY_25_MONTHLY=""
STRIPE_PRICE_AGENCY_25_YEARLY=""
STRIPE_PRICE_AGENCY_50_MONTHLY=""
STRIPE_PRICE_AGENCY_50_YEARLY=""

# --- Coupons Stripe du brief growth (lots G1/G2) ---
# À créer À LA MAIN dans Stripe (Produits → Coupons), puis coller ici leur
# identifiant (ex. "Z4OX9tWi") — pas le code promo, l'id du coupon.
#   STRIPE_FIRST_MONTH_COUPON : « -50 % le premier mois », 50 % de remise,
#     durée « une fois » (once). Appliqué au Checkout MENSUEL pendant les
#     48 h de l'offre de bienvenue (voir src/app/api/billing/checkout/route.ts).
#     Tant que la variable est vide, l'offre n'est simplement pas proposée.
#   STRIPE_FREE_MONTH_COUPON : « un mois de Pro offert », 100 % de remise,
#     durée « une fois » (once). Récompense du badge « Propulsé par Nebula »
#     et du parrainage (voir src/lib/billing/rewards.ts) : appliqué à
#     l'abonnement actif du parrain, ou au prochain Checkout (bonusMonths).
STRIPE_FIRST_MONTH_COUPON=""
STRIPE_FREE_MONTH_COUPON=""

# --- Langue des écrans Google (connexion Google + connexion YouTube) ---
# Mettre "en" pendant l'enregistrement de la vidéo de l'audit de vérification
# Google : les pages compte / consentement / « appli non validée » s'affichent
# alors en anglais (paramètre hl), comme Google l'exige. Laisser vide ensuite
# pour que chaque visiteur retrouve la langue de son navigateur.
GOOGLE_OAUTH_LANG=""

# --- Codes promo partenaires ---
# Rien à configurer ici : les codes promo se créent dans Stripe (Produits →
# Coupons → Codes promotionnels) et sont acceptés sur la page de paiement.
# Les accès offerts sans carte se gèrent depuis /admin/partenaires.

# --- Soutenir Nebula (optionnel) ---
# Lien de don affiché sur la page "Soutenir Nebula" (Ko-fi, Buy Me a Coffee,
# PayPal.me, Stripe Payment Link...). Tant qu'il est vide, la page l'indique
# honnêtement et n'affiche aucun bouton de paiement.
NEXT_PUBLIC_DONATE_URL=""

# --- Content-Security-Policy (Lot 5, voir src/middleware.ts) -----------------
# En production la politique est APPLIQUÉE (les scripts non autorisés sont
# bloqués par le navigateur). Si quelque chose casse après un déploiement,
# mettre CSP_MODE=report-only sur Vercel repasse en mode rapport (rien n'est
# bloqué, les violations s'affichent dans la console) sans toucher au code.
CSP_MODE=""
